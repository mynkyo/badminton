{
  "hosting": {
    "site": "dat-san-cau-long",
    "public": ".",
    "cleanUrls": true,
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "migrate.js",
      "firestore.rules"
    ],
    "rewrites": [
      { "source": "/", "destination": "/index.html" },
      { "source": "/index.html", "destination": "/index.html" },
      { "source": "/migrate", "destination": "/migrate.html" },
      { "source": "/migrate.html", "destination": "/migrate.html" },
      { "source": "/register", "destination": "/register.html" },
      { "source": "/super-admin", "destination": "/super-admin.html" },
      { "source": "/login", "destination": "/login.html" },
      { "source": "/**/login", "destination": "/login.html" },
      { "source": "/**/login.html", "destination": "/login.html" },
      { "source": "/**/manage", "destination": "/manage.html" },
      { "source": "/**", "destination": "/court.html" }
    ]
  }
}
