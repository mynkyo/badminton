rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSuperAdmin() {
      return request.auth != null && request.auth.uid == 'kxPAhAAG4rOK432QLoLFOgWcgwq2';
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isStaffOf(courtId) {
      return request.auth != null && (
        isSuperAdmin() ||
        (getUserData().courtId == courtId && (getUserData().role == 'admin' || getUserData().role == 'manager'))
      );
    }

    function isAdminOfAnyCourt() {
      return request.auth != null && (
        isSuperAdmin() ||
        (getUserData().role == 'admin')
      );
    }

    // Users collection
    match /users/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (request.auth.uid == uid || isAdminOfAnyCourt());
    }

    // Registrations collection
    match /registrations/{regId} {
      allow create: if request.auth != null;
      allow read, update, delete: if isSuperAdmin();
    }

    // Courts collection & Sub-collections
    match /courts/{courtSlug} {
      allow read: if true;
      allow create, update, delete: if isSuperAdmin() || isStaffOf(courtSlug);

      match /bookings/{bookingId} {
        allow read: if true;
        allow create: if true;
        allow update, delete: if isStaffOf(courtSlug);
      }

      match /schedule/{docId} {
        allow read: if true;
        allow write: if isStaffOf(courtSlug);
      }
    }

    // Fallback settings for legacy migration
    match /settings/{docId} {
      allow read, write: if isSuperAdmin();
    }
    match /bookings/{docId} {
      allow read, write: if isSuperAdmin();
    }
  }
}
